{
  "name": "woc-cloudflare",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "none" },
