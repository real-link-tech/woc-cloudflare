{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "headless", "tests", "server"],
  "comment": "src/worker is the Cloudflare Worker runtime; it has its own tsconfig.worker.json (workers-types/pg, no DOM). The client config must not type-check it.",
  "exclude": ["src/worker"]
}
